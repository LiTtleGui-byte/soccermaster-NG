# Python bytecode and test/tool caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Local Python/Conda environments and dependency staging
.venv/
venv/
env/
.conda/
.conda_pkgs/
.conda_pkgs:/
.local_envs/
.local_deps/

# Packaging and native-extension build products
build/
dist/
*.egg
*.egg-info/
*.so
*.o
*.a

# Large datasets, pretrained models, and experiment artifacts
datasets/
pretrained_models/
checkpoints/
outputs/
artifacts/
tmp/

# Model weights and array dumps must stay outside Git
*.pt
*.pth
*.ckpt
*.safetensors
*.npy
*.npz

# Raw runtime logs are local; commit Markdown/JSON summaries intentionally
*.log
wandb/
runs/
lightning_logs/

# Local third-party or generated research material
dinov3/
paper/
models/bak/

# Editor, agent-runtime, and operating-system metadata
.vscode/
.idea/
.cursorignore
.agents/
.codex/
*.swp
*~
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Existing root-level local experiments/configuration; promote only after review
/memory_demo.py
/pyrightconfig.json
